# Supabase project URL and anon public key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend Django REST API URL (include /api)
# In production, e.g. https://your-backend.vercel.app/api or https://your-backend.onrender.com/api
VITE_API_URL=https://your-backend.vercel.app/api

# Comma-separated admin emails allowed to access /admin dashboard in frontend
VITE_ADMIN_EMAILS=admin@example.com,owner@khaasdry.com
